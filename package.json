{
  "name": "weihnachtslichter",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.5.0",
  "publisher": "ric3",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "christmas",
    "lights",
    "xmas",
    "weihnachten",
    "pixel",
    "holiday"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "weihnachtslichter.einschalten",
        "title": "%cmd.on%",
        "category": "%category%"
      },
      {
        "command": "weihnachtslichter.ausschalten",
        "title": "%cmd.off%",
        "category": "%category%"
      },
      {
        "command": "weihnachtslichter.position",
        "title": "%cmd.position%",
        "category": "%category%"
      }
    ],
    "configuration": {
      "title": "%category%",
      "properties": {
        "weihnachtslichter.aktiv": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.aktiv%"
        },
        "weihnachtslichter.position": {
          "type": "string",
          "default": "titelleiste",
          "enum": [
            "titelleiste",
            "statusleiste",
            "ueberAllem"
          ],
          "enumDescriptions": [
            "%cfg.position.titelleiste%",
            "%cfg.position.statusleiste%",
            "%cfg.position.ueberAllem%"
          ],
          "description": "%cfg.position%"
        },
        "weihnachtslichter.animation": {
          "type": "string",
          "default": "sparsam",
          "enum": [
            "sparsam",
            "fluessig",
            "aus"
          ],
          "enumDescriptions": [
            "%cfg.animation.sparsam%",
            "%cfg.animation.fluessig%",
            "%cfg.animation.aus%"
          ],
          "description": "%cfg.animation%"
        },
        "weihnachtslichter.groesse": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "%cfg.groesse%"
        },
        "weihnachtslichter.tempo": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 4,
          "description": "%cfg.tempo%"
        },
        "weihnachtslichter.abstandOben": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 200,
          "description": "%cfg.abstandOben%"
        }
      }
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ric3-12/vscode-extension-christmaslights.git"
  },
  "bugs": {
    "url": "https://github.com/ric3-12/vscode-extension-christmaslights/issues"
  },
  "homepage": "https://github.com/ric3-12/vscode-extension-christmaslights#readme",
  "galleryBanner": {
    "color": "#0a130e",
    "theme": "dark"
  },
  "l10n": "./l10n"
}