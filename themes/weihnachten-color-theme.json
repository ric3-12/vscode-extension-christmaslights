{
  "name": "Weihnachten Pixel",
  "type": "dark",
  "colors": {
    "focusBorder": "#d4af37",
    "foreground": "#e9efe9",
    "selection.background": "#c4302b66",
    "widget.shadow": "#00000080",

    "titleBar.activeBackground": "#0a130e",
    "titleBar.activeForeground": "#e9efe9",
    "titleBar.inactiveBackground": "#0a130e",
    "titleBar.inactiveForeground": "#7f9585",
    "titleBar.border": "#1a2e21",

    "activityBar.background": "#0a130e",
    "activityBar.foreground": "#f2c14e",
    "activityBar.inactiveForeground": "#5f7a67",
    "activityBar.activeBorder": "#c4302b",
    "activityBarBadge.background": "#c4302b",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#0d1912",
    "sideBar.foreground": "#cfdad1",
    "sideBar.border": "#1a2e21",
    "sideBarTitle.foreground": "#f2c14e",
    "sideBarSectionHeader.background": "#0a130e",
    "sideBarSectionHeader.foreground": "#f2c14e",

    "list.activeSelectionBackground": "#c4302b55",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#1d3a27",
    "list.hoverBackground": "#16291d",
    "list.highlightForeground": "#f2c14e",

    "editor.background": "#0f1c14",
    "editor.foreground": "#e9efe9",
    "editorLineNumber.foreground": "#3f5c48",
    "editorLineNumber.activeForeground": "#f2c14e",
    "editorCursor.foreground": "#ff4d4d",
    "editor.selectionBackground": "#c4302b55",
    "editor.lineHighlightBackground": "#15281c",
    "editor.findMatchBackground": "#d4af3766",
    "editor.findMatchHighlightBackground": "#d4af3733",
    "editorBracketMatch.border": "#f2c14e",
    "editorIndentGuide.background1": "#1a2e21",
    "editorIndentGuide.activeBackground1": "#3f5c48",
    "editorWhitespace.foreground": "#25402f",

    "editorGroupHeader.tabsBackground": "#0a130e",
    "tab.activeBackground": "#0f1c14",
    "tab.activeForeground": "#ffffff",
    "tab.activeBorderTop": "#c4302b",
    "tab.inactiveBackground": "#0a130e",
    "tab.inactiveForeground": "#7f9585",
    "tab.border": "#0a130e",

    "statusBar.background": "#0a130e",
    "statusBar.border": "#c4302b",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#1f5a33",
    "statusBar.debuggingBackground": "#d4af37",
    "statusBar.debuggingForeground": "#0a130e",
    "statusBarItem.remoteBackground": "#1f7a40",

    "panel.background": "#0a130e",
    "panel.border": "#1a2e21",
    "panelTitle.activeBorder": "#f2c14e",
    "panelTitle.activeForeground": "#ffffff",
    "terminal.background": "#0a130e",
    "terminal.foreground": "#e9efe9",
    "terminal.ansiRed": "#ff4d4d",
    "terminal.ansiGreen": "#3fd47a",
    "terminal.ansiYellow": "#f2c14e",
    "terminal.ansiBlue": "#5eb0ff",
    "terminal.ansiMagenta": "#e07ab8",
    "terminal.ansiCyan": "#7fdcd3",

    "button.background": "#c4302b",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#e03a34",
    "badge.background": "#c4302b",
    "badge.foreground": "#ffffff",
    "input.background": "#0a130e",
    "input.border": "#1f3a28",
    "dropdown.background": "#0a130e",
    "scrollbarSlider.background": "#3f5c4855",
    "scrollbarSlider.hoverBackground": "#3f5c4888",
    "progressBar.background": "#f2c14e",
    "textLink.foreground": "#f2c14e"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6b8a76", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#ff6b61" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#7ee08a" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#f2c14e" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#8fd3ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#ffb36b" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#e9efe9" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#f5d9a8" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff6b61" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f2c14e" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#b9c9bd" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#f2c14e", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#7ee08a" } }
  ]
}
